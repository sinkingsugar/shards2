diff --git a/examples/esp32/sdkconfig.defaults b/examples/esp32/sdkconfig.defaults
index dd47b19..f4fbd7d 100644
--- a/examples/esp32/sdkconfig.defaults
+++ b/examples/esp32/sdkconfig.defaults
@@ -1,7 +1,6 @@
-# Parsing and composing use the task stack even with the stackless scheduler.
-# The smoke driver is shallow. Acceptance suites allocate their own measured
-# task stack, freeing it between suites to leave room for instance state.
-CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
+# Parsing and composing remain recursive. Reserve the full acceptance stack
+# at boot, before test allocations fragment the heap (especially on C3).
+CONFIG_ESP_MAIN_TASK_STACK_SIZE=131072
 CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
 CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
 CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
diff --git a/examples/esp32/src/main.rs b/examples/esp32/src/main.rs
index 666bee1..2e8c57a 100644
--- a/examples/esp32/src/main.rs
