+#[test]
+fn review_inline_reload_reports_component_reset_under_apply() {
+  let source = |delta| format!(r#"
+@fn(Counter stateful: true input: None output: Int params: {{}} {{ Keep(n 0) Inc(n) }})
+@fn(ReviewAdd input: Int output: Int params: {{}} {{ Math.Add({delta}) }})
+@wire(main {{ Counter Log ReviewAdd }} looped: true)
+@mesh(m) @schedule(m main) @run(m)
+"#);
+  let mut session = shards_lang::Session::new();
+  session.set_reset_policy(shards_core::ResetPolicy::Apply);
+  preserve(&mut session, &source(1));
+  let (_, before) = shards_core::log::capture(|| { session.tick(); });
+  assert_eq!(before, ["1"]);
+  preserve(&mut session, &source(10));
+  let report = session.reload_report().unwrap().clone();
+  let (_, after) = shards_core::log::capture(|| { session.tick(); });
+  if after == ["1"] {
+    assert!(report.reset.iter().any(|s| s.contains("Counter")), "lost Counter state absent from report: {report:?}");
+  } else { assert_eq!(after, ["2"]); }
+}
