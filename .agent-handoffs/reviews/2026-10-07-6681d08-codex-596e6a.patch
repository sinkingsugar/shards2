+#[test]
+fn review_inline_reload_does_not_silently_reset_unchanged_component() {
+  let source = |delta| format!(r#"
+@fn(Counter stateful: true input: None output: Int params: {{}} {{ Keep(n 0) Inc(n) }})
+@fn(ReviewAdd input: Int output: Int params: {{}} {{ Math.Add({delta}) }})
+@wire(main {{ Counter Log ReviewAdd }} looped: true)
+@mesh(m) @schedule(m main) @run(m)
+"#);
+  let mut session = shards_lang::Session::new();
+  preserve(&mut session, &source(1));
+  let (_, lines) = shards_core::log::capture(|| {
+    session.tick();
+    session.tick();
+    let result = session.reload_preserving(Source::new("t.shs", source(10)), &catalog(), &no_defines());
+    if let Err((_, d)) = result {
+      assert_eq!(d[0].code, "reload-resets-state");
+    } else {
+      let report = session.reload_report().unwrap();
+      assert!(report.reset.is_empty(), "default Reject accepted resets: {report:?}");
+    }
+    session.tick();
+  });
+  assert_eq!(lines, ["1", "2", "3"], "unchanged Counter state was lost");
+}
