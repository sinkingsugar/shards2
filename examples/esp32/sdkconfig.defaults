# Parsing and composing use the task stack even with the stackless scheduler.
# The smoke driver is shallow. Acceptance suites allocate their own measured
# task stack, freeing it between suites to leave room for instance state.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
